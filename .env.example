# ==========================================
# edgetunnel 服务端部署环境变量配置
# ==========================================

# 1. 必填：管理员密码（后台登录与权限控制）
ADMIN=admin888888

# 2. 推荐：快速订阅密钥（访问 https://域名/此密钥 即可自动跳转订阅）
KEY=my_secret_token_123

# 3. 您的服务器解析域名（如 vps.yourdomain.com）
HOST=

# 4. 监听端口（默认 8080）
PORT=8080

# 5. 可选配置
# 自定义 UUID（不填时会根据 ADMIN + KEY 自动计算生成标准 UUID）
# UUID=

# 自定义回源 ProxyIP（不填时走默认节点）
# PROXYIP=

# 伪装网站目标地址（默认显示内置 Nginx 欢迎页）
# URL=https://bing.com
